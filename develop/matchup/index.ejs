<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="Content-Style-Type" content="text/css" />
    <meta http-equiv="Content-Script-Type" content="text/javascript" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Cache-Control" content="no-cache" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <title>Pokémon Matchup Helper</title>
    <link rel="stylesheet" href="css/style.css?t=20260916" />
  </head>
  <body class="is_empty">
    <div class="container">
      <%- include('common/_header.ejs') %>
      <div class="contents">
        <div class="matchup-empty">
          <p>
            <a href="javascript:void(0);" class="js_filter-trigger">相手のタイプまたは<br>ポケモンを選択してください</a>
          </p>
        </div>
        <div class="matchup">
          <section class="pokemon-type js_pokemon-type-effect">
            <h2 class="section-header">わざのタイプとこうか</h2>
            <div class="pokemon-type-summery-wrapper js_pokemon-summery-wrapper">
              <div class="pokemon-type-summery">
                <dl class="pokemon-type-summery-list">
                  <dt class="pokemon-type-summery-list-label">ばつぐん<span class="multiplier">2.56</span></dt>
                  <dd class="pokemon-type-summery-list-value">
                    <ul class="js_effect js_effect5"></ul>
                  </dd>
                </dl>
                <dl class="pokemon-type-summery-list">
                  <dt class="pokemon-type-summery-list-label">ばつぐん<span class="multiplier">1.6</span></dt>
                  <dd class="pokemon-type-summery-list-value">
                    <ul class="js_effect js_effect4"></ul>
                  </dd>
                </dl>
              </div>
            </div>
            <div class="pokemon-type-table-wrapper js_pokemon-table-wrapper">
              <table class="type-table">
                <tr>
                  <th>ばつぐん<span class="multiplier">2.56</span></th>
                  <td>
                    <ul class="js_effect js_effect5"></ul>
                  </td>
                </tr>
                <tr>
                  <th>ばつぐん<span class="multiplier">1.6</span></th>
                  <td>
                    <ul class="js_effect js_effect4"></ul>
                  </td>
                </tr>
                <tr>
                  <th>ふつう<span class="multiplier">1.0</span></th>
                  <td>
                    <ul class="js_effect js_effect3"></ul>
                  </td>
                </tr>
                <tr>
                  <th>いまひとつ<span class="multiplier">0.63</span></th>
                  <td>
                    <ul class="js_effect js_effect2"></ul>
                  </td>
                </tr>
                <tr>
                  <th>いまひとつ<span class="multiplier">0.39</span></th>
                  <td>
                    <ul class="js_effect js_effect1"></ul>
                  </td>
                </tr>
              </table>
            </div>
            <div class="pokemon-type-toggle-trigger">
              <a href="javascript:void(0);" class="pokemon-type-toggle-open js_toggle-trigger">もっとみる</a>
              <a href="javascript:void(0);" class="pokemon-type-toggle-close js_toggle-trigger">閉じる</a>
            </div>
          </section>
          <section class="pokemon-recommend">
            <h2 class="section-header">対策おすすめ</h2>
            <div class="pokemon-info-list js_pokemon-info-list">
            </div>
          </section>
        </div>
      </div>
      <%- include('common/_footer.ejs') %>
    </div>
    <div class="filter-overlay js_filter-overlay"></div>
    <section class="filter js_filter filter-pokemon-search">
      <h2 class="section-header">
        <a href="javascript:void(0);" class="js_filter-trigger">相手をえらぶ</a>
      </h2>
      <div class="filter-inner">
        <div class="pokemon-search-and-or">
          <ul class="pokemon-search-and-or-list">
            <li class="pokemon-search-and-or-list-item">
              <input type="radio" name="and_or" id="and_or-and" value="and" checked>
              <label for="and_or-and">すべて含む</label>
            </li>
            <li class="pokemon-search-and-or-list-item">
              <input type="radio" name="and_or" id="and_or-or" value="or">
              <label for="and_or-or">いずれか含む</label>
            </li>
          </ul>
        </div>
        <div class="pokemon-type">
          <ul class="pokemon-type-list js_pokemon-type-list">
            <li>
              <input type="checkbox" name="pokemon-type" id="type-normal" value="normal"><label for="type-normal"><span class="icon-type icon-type-normal"></span>ノーマル</label>
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-fire" value="fire"><label for="type-fire"><span class="icon-type icon-type-fire"></span>ほのお</label>
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-water" value="water"><label for="type-water" ><span class="icon-type icon-type-water"></span>みず</label>
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-grass" value="grass" ><label for="type-grass" ><span class="icon-type icon-type-grass"></span>くさ</label >
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-electric" value="electric"><label for="type-electric"><span class="icon-type icon-type-electric"></span>でんき</label >
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-ice" value="ice"><label for="type-ice"><span class="icon-type icon-type-ice"></span>こおり</label >
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-fighting" value="fighting"><label for="type-fighting"><span class="icon-type icon-type-fighting"></span>かくとう</label>
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-poison" value="poison"><label for="type-poison"><span class="icon-type icon-type-poison"></span>どく</label>
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-ground" value="ground"><label for="type-ground"><span class="icon-type icon-type-ground"></span>じめん</label>
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-flying" value="flying"><label for="type-flying"><span class="icon-type icon-type-flying"></span>ひこう</label>
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-psychic" value="psychic"><label for="type-psychic"><span class="icon-type icon-type-psychic"></span>エスパー</label>
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-bug" value="bug"><label for="type-bug"><span class="icon-type icon-type-bug"></span>むし</label>
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-rock" value="rock"><label for="type-rock"><span class="icon-type icon-type-rock"></span>いわ</label>
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-ghost" value="ghost"><label for="type-ghost"><span class="icon-type icon-type-ghost"></span>ゴースト</label>
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-dragon" value="dragon"><label for="type-dragon"><span class="icon-type icon-type-dragon"></span>ドラゴン</label>
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-dark" value="dark"><label for="type-dark"><span class="icon-type icon-type-dark"></span>あく</label>
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-steel" value="steel"><label for="type-steel"><span class="icon-type icon-type-steel"></span>はがね</label>
            </li>
            <li>
              <input type="checkbox" name="pokemon-type" id="type-fairy" value="fairy"><label for="type-fairy"><span class="icon-type icon-type-fairy"></span>フェアリー</label>
            </li>
          </ul>
          <div class="pokemon-type-error js_error-msg">
            ポケモンのタイプは2つまでです。
          </div>
        </div>
        <div class="pokemon-search-wrapper">
          <div class="pokemon-search js_pokemon-search">
            <div class="pokemon-search-input-wrapper">
              <input type="text" name="pokemon-search-input" class="pokemon-search-input js_pokemon-search-input" placeholder="ポケモンを選択">
              <a href="javascript:void(0);" class="pokemon-search-input-clear js_reset js_search-clear" style="display: none;"></a>
            </div>
            <div class="pokemon-search-list-wrapper">
              <ul class="pokemon-search-list js_pokemon-search-list"></ul>
            </div>
            <div class="pokemon-search-result js_pokemon-search-result">
            </div>
          </div>
        </div>
        <div class="filter-btns">
          <a href="javascript:void(0);" class="filter-close js_filter-trigger">結果をみる</a>
          <a href="javascript:void(0);" class="filter-reset js_reset">reset</a>
        </div>
      </div>
    </section>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
    <script src="js/utilities.js?t=20260916" defer></script>
    <script src="js/matchup.js?t=20260916" defer></script>
  </body>
</html>
